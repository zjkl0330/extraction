{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-saver",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },

  "browser": {
    "binding": "BROWSER"
  }
}