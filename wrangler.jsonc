{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-saver",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },

  "browser": {
    "binding": "BROWSER"
  },

  "kv_namespaces": [
    {
      "binding": "DOUYIN_KV",
      "id": "cec2f6ee74044c10af696e0b7b107b22"
    }
  ],

  "vars": {
    "RELAY_BASE": "https://exit.zjkl.qzz.io",
    "RELAY_KEY": "sk_main_69d7c3cee69c5b2f0b448061d7c87c5b"
  }
}